{
	"name": "sveltekit-query-live",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"clean:worker-types": "node -e \"const fs = require('node:fs'); for (const p of ['.svelte-kit/cloudflare', '.svelte-kit/cloudflare-tmp']) fs.rmSync(p, { recursive: true, force: true })\"",
		"build": "pnpm run clean:worker-types && wrangler types --check && vp build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm run clean:worker-types && wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp check",
		"format": "vp check --fix",
		"test:unit": "vp test",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen": "pnpm run clean:worker-types && wrangler types"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-cloudflare": "8.0.3",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.2.4",
		"@types/node": "^26.0.0",
		"@vitest/browser-playwright": "5.1.0",
		"playwright": "^1.59.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.2.4",
		"typescript": "6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
		"vite-plus": "1.6.0",
		"vitest": "5.1.0",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "4.164.0"
	}
}
